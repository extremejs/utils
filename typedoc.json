{
  "tsconfig": "tsconfig.build.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "intentionallyNotExported": [
    "src/get.ts:BracketKeyT",
    "src/get.ts:ValueAtKeyT",
    "src/is-instance-of.ts:InstanceTarget",
    "src/internal/numeric-property.ts:DefaultPropertyT",
    "src/internal/numeric-property.ts:NumericPropertyT",
    "src/internal/read-path.ts:FallbackArgsT",
    "src/internal/read-path.ts:ReadResultT",
    "src/internal/string-symbols.ts:CaseFirstSymbolT",
    "src/to-path.ts:ParsePathT"
  ],
  "out": "docs",
  "includeVersion": true,
  "searchInComments": true,
  "githubPages": true,
  "cleanOutputDir": true
}
