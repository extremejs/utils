{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "allowJs": false,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "test",
    "src/**/*.spec.ts",
    "scripts",
    "vitest.config.ts",
    "commitlint.config.ts",
    "knip.config.ts",
    "oxlint.config.ts",
  ],
}
